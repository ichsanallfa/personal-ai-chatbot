{
  "name": "personal-ai-chatbot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue.bold,green.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start": "npm --prefix backend start",
    "test": "npm --prefix backend test",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "lint:frontend": "npm --prefix frontend run lint"
  },
  "dependencies": {
    "vtubestudio": "^3.11.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
