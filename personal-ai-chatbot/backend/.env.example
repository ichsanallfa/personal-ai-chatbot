# ============================================
# Environment Variables Template
# Copy file ini menjadi .env lalu isi nilainya
# JANGAN PERNAH push file .env ke GitHub!
# ============================================

# OpenRouter API Key
# Dapatkan di: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Discord Bot Token
# Dapatkan di: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Discord Owner ID — ID akun Discord Anda
DISCORD_OWNER_ID=

# User ID Discord yang diizinkan menggunakan bot (pisahkan dengan koma).
# Kosongkan atau isi "*" jika ingin MODE PUBLIK (semua orang bisa chat).
ALLOWED_USER_IDS=

# Telegram Bot Token
# Dapatkan dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=

# User ID Telegram yang diizinkan menggunakan bot (pisahkan dengan koma).
# Kosongkan atau isi "*" jika ingin MODE PUBLIK (semua orang bisa chat).
TELEGRAM_ALLOWED_USERS=

# Port untuk backend server
PORT=3001