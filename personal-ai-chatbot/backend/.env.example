# ============================================
# Environment Variables Template
# Copy file ini menjadi .env lalu isi nilainya
# JANGAN PERNAH push file .env ke GitHub!
# ============================================

# OpenRouter API Key
# Dapatkan di: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Discord Bot Token
# Dapatkan di: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Discord Owner ID — ID akun Discord Anda
DISCORD_OWNER_ID=

# Telegram Bot Token & Owner ID
# Dapatkan dari @BotFather di Telegram (Owner ID bisa didapat dari /id atau /whoami)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# User ID Discord yang diizinkan (pisahkan dengan koma).
# Kosongkan atau isi "*" jika ingin MODE PUBLIK (semua orang bisa chat).
ALLOWED_USER_IDS=

# User ID Telegram yang diizinkan (pisahkan dengan koma).
# Kosongkan atau isi "*" jika ingin MODE PUBLIK (semua orang bisa chat).
TELEGRAM_ALLOWED_USERS=

# Port untuk backend server
PORT=3001