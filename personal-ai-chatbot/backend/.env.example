# Server & Network
PORT=3001
FRONTEND_URL=*
BACKEND_URL=http://localhost:3001/api/chat

# Security (JWT & Bot Key)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
SERVICE_API_KEY=your_bot_service_key_here
OWNER_SECRET_KEY=your_owner_login_password_here

# Access Control (ID Discord & Telegram)
DISCORD_OWNER_ID=
TELEGRAM_OWNER_ID=
OWNER_USER_IDS=
DISCORD_ALLOWED_USERS=
TELEGRAM_ALLOWED_USERS=
ALLOWED_USER_IDS=

# AI Provider (openrouter / gemini / openai / mock)
AI_PROVIDER=openrouter
AI_MODEL=deepseek/deepseek-chat
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
GEMINI_API_KEY=
OPENAI_API_KEY=

# Bot Tokens
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# VTube Studio
VTUBE_WS_URL=ws://127.0.0.1:8001
VTUBE_PLUGIN_NAME=Lucy AI
VTUBE_PLUGIN_DEVELOPER=Alfaa

# Rate Limiter
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_CHAT=30
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_GENERAL=100