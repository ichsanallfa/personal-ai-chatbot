# ============================================
# Environment Variables Template
# Copy file ini menjadi .env lalu isi nilainya
# JANGAN PERNAH push file .env ke GitHub!
# ============================================

# OpenRouter API Key
# Dapatkan di: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Discord Bot Token
# Dapatkan di: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Discord Owner ID — ID akun Discord Anda
DISCORD_OWNER_ID=

# User ID yang diizinkan menggunakan bot (pisahkan dengan koma jika lebih dari satu)
ALLOWED_USER_IDS=

# Port untuk backend server
PORT=3001